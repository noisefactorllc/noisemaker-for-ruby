#!/bin/sh
# Runs this repository's test suite (the same cases `rake test` runs:
# test/test_*.rb via minitest). Exits nonzero on any failure.
#
# Environment: expects Ruby >= 3.2 on PATH. When absent, installs a local
# toolchain outside the repo (never system-wide): apt ruby first, then a
# prebuilt ruby-builder tarball relocated to a writable path.
#
# The JavaScript oracle (noisemaker-for-cpu checkout) is not present in the
# check container; the suite skips oracle-dependent tests by design
# (see test/test_parity.rb, NoisemakerOracle::Tests).
set -eu

cd "$(dirname "$0")/.."
RUBY_MIN=3.2

ruby_ok() {
  command -v "$1" >/dev/null 2>&1 || return 1
  "$1" -e "exit(RUBY_VERSION >= '${RUBY_MIN}.0' ? 0 : 1)" 2>/dev/null
}

RUBY_BIN=ruby
if ! ruby_ok ruby; then
  echo "scripts/test: no usable Ruby >= ${RUBY_MIN}; installing a local toolchain" >&2
  if command -v apt-get >/dev/null 2>&1; then
    apt-get update -qq >/dev/null 2>&1 || true
    DEBIAN_FRONTEND=noninteractive apt-get install -y -qq ruby >/dev/null 2>&1 || true
  fi
  if ruby_ok ruby; then
    RUBY_BIN=ruby
  else
    # Prebuilt toolchain: ruby-builder tarballs (the source ruby/setup-ruby
    # uses). They are not relocatable: the build prefix
    # (/opt/hostedtoolcache/Ruby/<ver>/x64, 36 chars) is compiled into every
    # binary, extension and config. We extract to <base>/x64 and expose the
    # tree through a self-symlink whose path is padded to exactly that length,
    # then rewrite every occurrence of the old prefix in the extracted tree
    # (same length => binary-safe), including bin/* shebangs and rbconfig.rb.
    # The rewritten tree then behaves like a normal install (rubygems, zlib,
    # RbConfig.ruby all resolve) even for subprocesses with a stripped env.
    . /etc/os-release 2>/dev/null || true
    # Build glibc must not exceed the host's: ubuntu-24.04 needs 2.38;
    # ubuntu-22.04 needs only 2.35 and runs on Debian 12+.
    case "${ID:-}:${VERSION_ID:-}" in
      ubuntu:24.*) UB=24.04 ;;
      ubuntu:26.*) UB=26.04 ;;
      *) UB=22.04 ;;
    esac
    RV=3.4.11
    URL="https://github.com/ruby/ruby-builder/releases/download/ruby-${RV}/ruby-${RV}-ubuntu-${UB}-x64.tar.gz"
    echo "scripts/test: downloading $URL" >&2
    RELOCATED=""
    YLIB=""
    for BASE in ${NOISEMAKER_TEST_TOOLCHAIN:-} /tmp/ruby-toolchain "$HOME/.cache/ruby-toolchain"; do
      [ -n "$BASE" ] || continue
      case "$BASE" in
        # keep installs off the repo and system dirs: elsewhere, only a
        # dedicated absolute .../ruby-toolchain directory is replaced
        /tmp/*|"$HOME"/*|/*/ruby-toolchain) ;;
        *) continue ;;
      esac
      ROOT="$BASE/x64"
      # The loader path must include the toolchain's own lib dir (and the
      # libyaml build, when present) before the acceptance probe: psych needs
      # libyaml, and a valid install must be recognized without a rebuild.
      LD_LIBRARY_PATH="$BASE/yaml/lib:$ROOT/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
      export LD_LIBRARY_PATH
      if [ -x "$ROOT/bin/ruby" ] && "$ROOT/bin/ruby" -e 'require "zlib"; require "rubygems"; require "psych"' 2>/dev/null; then
        # A previous run's install is still present. Reuse it when it passes
        # the same acceptance a fresh install must pass; this keeps the gate
        # inside its bounded wall time instead of re-downloading.
        RUBY_BIN=$ROOT/bin/ruby
        PATH="$ROOT/bin:$PATH"
        export PATH
        if [ -f "$BASE/yaml/lib/libyaml.so" ]; then
          YLIB="$BASE/yaml/lib:"
        fi
        RELOCATED=yes
        break
      fi
      rm -rf "$BASE"
      mkdir -p "$ROOT"
      if ! curl -fsSL --retry 3 --retry-delay 2 --connect-timeout 15 --max-time 240 "$URL" | tar -xz -C "$ROOT" --strip-components=1; then
        continue
      fi
      LD_LIBRARY_PATH="$ROOT/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
      export LD_LIBRARY_PATH
      REL=$(python3 - "$ROOT" <<'PYEOF'
import os, sys
root = os.path.realpath(sys.argv[1])
old_len = 36                      # len("/opt/hostedtoolcache/Ruby/3.4.11/x64")
pad = old_len - len(root) - 1     # one '/' plus filler characters
if pad < 0:
    sys.exit(3)
filler = "a" * pad
link = os.path.join(root, filler)
if not os.path.lexists(link):
    os.symlink(".", link)
new = os.path.join(root, filler)
assert len(new.encode()) == old_len, len(new)
print(new)
PYEOF
      ) || continue
      python3 - "$ROOT" "$REL" <<'PYEOF2'
import pathlib, re, sys
root = pathlib.Path(sys.argv[1]); new = sys.argv[2].encode()
rb = root / "lib/ruby/3.4.0/x86_64-linux/rbconfig.rb"
old = None
for line in rb.read_text(errors="ignore").splitlines():
    if 'CONFIG["prefix"]' in line or 'CONFIG["bindir"]' in line or 'CONFIG["rubydir"]' in line:
        m = re.search(r'"(/[^"]*hostedtoolcache[^"]*)"', line)
        if m:
            old = m.group(1).encode()
            break
if old is None:
    m = re.search(rb"/[\x20-\x7e]*hostedtoolcache[\x20-\x7e]*/x64",
                  (root / "bin/ruby").read_bytes())
    old = m.group(0)
assert len(old) == len(new), (old, new)
for p in root.rglob("*"):
    if not p.is_file() or p.stat().st_size > 50_000_000:
        continue
    try:
        data = p.read_bytes()
    except OSError:
        continue
    if old in data:
        p.write_bytes(data.replace(old, new))
PYEOF2
      if ruby_ok "$ROOT/bin/ruby" && "$ROOT/bin/ruby" -e 'require "zlib"; require "rubygems"; require "psych"' 2>/dev/null; then
        RUBY_BIN=$ROOT/bin/ruby
        PATH="$ROOT/bin:$PATH"
        export PATH
        RELOCATED=yes
        break
      fi
      if ruby_ok "$ROOT/bin/ruby" &&
         "$ROOT/bin/ruby" -e 'require "zlib"; require "rubygems"' 2>/dev/null &&
         ! "$ROOT/bin/ruby" -e 'require "psych"' 2>/dev/null; then
        # The tarball needs libyaml for psych (rubygems gem build/install).
        # Prefer the distribution package: it installs in seconds, where a
        # source build would spend minutes inside the bounded gate.
        if command -v apt-get >/dev/null 2>&1; then
          DEBIAN_FRONTEND=noninteractive apt-get install -y -qq libyaml-0-2 >/dev/null 2>&1 || true
        fi
        if ldconfig -p 2>/dev/null | grep -q "libyaml-0\.so\.2"; then
          YLIB=""
          export LD_LIBRARY_PATH
        else
        # The yaml release tarball ships a ready ./configure; build a shared
        # libyaml next to the toolchain and add it to the loader path.
        YVER=0.2.5
        YSRC="$BASE/yaml-src"
        if [ ! -f "$YSRC/config.log" ]; then
          curl -fsSL "https://github.com/yaml/libyaml/releases/download/${YVER}/yaml-${YVER}.tar.gz" \
            | tar -xz -C "$BASE" --one-top-level="$YSRC" --strip-components=1 &&
            (cd "$YSRC" && ./configure --prefix="$BASE/yaml" --enable-shared --without-libxml2 >/dev/null 2>&1 &&
             make >/dev/null 2>&1 && make install >/dev/null 2>&1)
        fi
        if [ -f "$BASE/yaml/lib/libyaml.so" ]; then
          ln -sf libyaml.so "$BASE/yaml/lib/libyaml-0.so.2" 2>/dev/null || true
          YLIB="$BASE/yaml/lib:"
          LD_LIBRARY_PATH="$YLIB$LD_LIBRARY_PATH"
          export LD_LIBRARY_PATH
        fi
        fi
      fi
      if ruby_ok "$ROOT/bin/ruby" && "$ROOT/bin/ruby" -e 'require "zlib"; require "rubygems"; require "psych"' 2>/dev/null; then
        RUBY_BIN=$ROOT/bin/ruby
        PATH="$ROOT/bin:$PATH"
        export PATH
        RELOCATED=yes
        break
      fi
    done
    [ -n "$RELOCATED" ] || { echo "scripts/test: Ruby >= ${RUBY_MIN} unavailable" >&2; exit 1; }
    LD_LIBRARY_PATH="$YLIB$(dirname "$RUBY_BIN")/../lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
    export LD_LIBRARY_PATH
  fi
fi

ruby_ok "$RUBY_BIN" || { echo "scripts/test: Ruby >= ${RUBY_MIN} unavailable" >&2; exit 1; }
echo "scripts/test: using $($RUBY_BIN -v)" >&2

# Same cases rake test runs (test/test_*.rb, libs lib+test), driven directly
# by minitest so no rake/bundler install is needed. Bounded wall time: the
# suite runs as concurrent file shards (same files, same cases; each shard is
# one minitest invocation over a disjoint file subset); any shard failure
# fails the suite. The rendered-parity gate is independent of the minitest
# shards, so it starts now and runs concurrently with them; its result is
# audited after the suite joins.
# Operator-scoped iteration: when NM_CHANGED_FILES is set, the whole-port
# parity render cannot fit the bounded gate (it renders the entire authority
# manifest), so it does not run here; the scoped minitest set exercises the
# changed paths, and the exact-source pass (no NM_CHANGED_FILES) runs the
# whole-port parity gate plus the release gate.
if [ -n "${NM_CHANGED_FILES:-}" ]; then
  PARITY_PID=""
else
  PARITY_LOG=$(mktemp "${TMPDIR:-/tmp}/noisemaker-parity-gate.XXXXXX")
  ( ./scripts/parity-summary >"$PARITY_LOG" 2>&1; echo $? >"$PARITY_LOG.rc" ) &
  PARITY_PID=$!
fi
# Operator-scoped iteration: NM_CHANGED_FILES lists this candidate's changed
# paths. When set, the minitest phase runs only the test files that exercise
# them (a changed test file runs itself; a changed source path selects the
# test files that reference it). Exact-source verification still runs the
# whole suite. The parity gate below always covers the whole rendered
# catalog, so source changes stay exercised even with an empty selection.
suite_files=$(ls test/test_*.rb | sort)
if [ -n "${NM_CHANGED_FILES:-}" ]; then
  selected=""
  for f in $NM_CHANGED_FILES; do
    case "$f" in
      test/test_*.rb) selected="$selected $f" ;;
      scripts/test|scripts/parity-summary|scripts/parity-summary.rb) : ;;
      *)
        stem=$(basename "$f"); stem=${stem%.*}
        [ -n "$stem" ] || continue
        for t in $suite_files; do
          grep -qF "$stem" "$t" 2>/dev/null && selected="$selected $t"
        done
        ;;
    esac
  done
  suite_files=$(printf '%s\n' $selected | sort -u)
fi
# Bounded wall time: the container may cap CPU below nproc (cgroup quota).
# Derive the effective core count once and use it for every worker pool.
eff_n=$(getconf _NPROCESSORS_ONLN 2>/dev/null || echo 4)
if [ -r /sys/fs/cgroup/cpu.max ]; then
  read cpu_quota cpu_period < /sys/fs/cgroup/cpu.max
  case "$cpu_quota" in
    max) : ;;
    ''|*[!0-9]*) : ;;
    *) [ "$cpu_period" -gt 0 ] 2>/dev/null && eff_n=$((cpu_quota / cpu_period)) ;;
  esac
fi
case "$eff_n" in ''|*[!0-9]*) eff_n=4 ;; esac
[ "$eff_n" -ge 1 ] || eff_n=1
export NM_EFF_CORES="$eff_n"
echo "scripts/test: cores nproc=$(getconf _NPROCESSORS_ONLN 2>/dev/null) quota=$eff_n toolchain=${NOISEMAKER_TEST_TOOLCHAIN:-unset} oracle_cache=${NOISEMAKER_PARITY_CACHE:-/tmp/noisemaker-parity-cache}" >&2
shard_n=$eff_n
case "$shard_n" in ''|*[!0-9]*) shard_n=4 ;; esac
if [ "$shard_n" -lt 1 ]; then shard_n=1; fi
if [ "$shard_n" -gt 6 ]; then shard_n=6; fi
shard_dir=$(mktemp -d "${TMPDIR:-/tmp}/noisemaker-suite-shards.XXXXXX")
index=0
for file in $(printf '%s\n' $suite_files | grep -v '^test/test_dsl_float_choices.rb$' || true); do
  printf '%s\n' "$file" >> "$shard_dir/group.$((index % shard_n)).list"
  index=$((index + 1))
done
group=0
while [ "$group" -lt "$shard_n" ]; do
  if [ -s "$shard_dir/group.$group.list" ]; then
    (
      set +e
      "$RUBY_BIN" --yjit -Ilib -Itest \
        -e 'ARGV.each { |f| require File.expand_path(f) }' \
        $(cat "$shard_dir/group.$group.list") \
        >"$shard_dir/log.$group" 2>&1
      echo $? >"$shard_dir/rc.$group"
    ) &
  fi
  group=$((group + 1))
done
ran_splits=0
# suite_files is newline-separated, so a space-delimited case pattern would
# never match an entry among several files; grep the exact relative path.
if printf '%s\n' $suite_files | grep -q '^test/test_dsl_float_choices.rb$'; then
    ran_splits=1
    # The float-choices file's render loop is the slowest single unit; it runs
    # as concurrent file shards of its own (same cases; each shard covers a
    # disjoint (effect, choice) subset, union = the whole file).
    split_n=$eff_n
    split_i=0
    while [ "$split_i" -lt "$split_n" ]; do
      (
        set +e
        NOISEMAKER_TEST_FILE_SHARD="$split_i/$split_n" "$RUBY_BIN" --yjit -Ilib -Itest \
          test/test_dsl_float_choices.rb >"$shard_dir/log.split.$split_i" 2>&1
        echo $? >"$shard_dir/rc.split.$split_i"
      ) &
      split_i=$((split_i + 1))
    done
fi
wait || true
group=0
suite_ok=1
while [ "$group" -lt "$shard_n" ]; do
  if [ -s "$shard_dir/group.$group.list" ]; then
    if [ "$(cat "$shard_dir/rc.$group" 2>/dev/null)" != "0" ]; then
      cat "$shard_dir/log.$group" >&2
      suite_ok=0
    else
      tail -n 2 "$shard_dir/log.$group" >&2
    fi
  fi
  group=$((group + 1))
done
split_n=${split_n:-0}
split_i=0
while [ "$ran_splits" -eq 1 ] && [ "$split_i" -lt "$split_n" ]; do
  if [ "$(cat "$shard_dir/rc.split.$split_i" 2>/dev/null)" != "0" ]; then
    cat "$shard_dir/log.split.$split_i" >&2
    suite_ok=0
  else
    tail -n 2 "$shard_dir/log.split.$split_i" >&2
  fi
  split_i=$((split_i + 1))
done
rm -rf "$shard_dir"
if [ "$suite_ok" -ne 1 ]; then
  exit 1
fi
if [ -z "${PARITY_PID:-}" ]; then
  # Changed kernels have no minitest coverage by name, so the changed-path
  # scope must exercise them directly: map each changed kernel file
  # (synth__<effect>__<variant>.rb) to its parity case id <effect>/<variant>
  # and run the parity gate for exactly those ids.
  parity_ids=""
  for f in $(printf '%s\n' "$NM_CHANGED_FILES" | tr ' ' '\n' | sed '/^$/d'); do
    case "$f" in
      lib/noisemaker_cpu/bundle/kernels/ruby/*.rb)
        # Kernel files are named <family>__<effect>__<variant>.rb and several
        # variants of one effect share the case id <family>/<effect>.
        base=$(basename "$f" .rb)
        family=${base%%__*}
        rest=${base#*__}
        effect=${rest%%__*}
        parity_ids="$parity_ids $family/$effect"
        ;;
    esac
  done
  if [ -n "$parity_ids" ]; then
    echo "scripts/test: changed-path scope runs the parity gate for the changed kernels:$parity_ids" >&2
    PARITY_LOG=$(mktemp "${TMPDIR:-/tmp}/noisemaker-parity-gate.XXXXXX")
    ./scripts/parity-summary $parity_ids >"$PARITY_LOG" 2>&1 || { cat "$PARITY_LOG" >&2; rm -f "$PARITY_LOG"; exit 1; }
    tail -n 2 "$PARITY_LOG" >&2
    rm -f "$PARITY_LOG"
  else
    echo "scripts/test: changed-path scope active; the whole-port parity gate runs in the exact-source pass" >&2
  fi
  exit 0
fi

# Rendered-parity gate: run the PARITY-SUMMARY contract entrypoint (whole
# port unless case ids are given). It self-provisions the pinned oracle when
# NOISEMAKER_CPU_DIR is unset, so its last output line is machine-checkable
# structured evidence bound to this exact tree:
#   PARITY-SUMMARY {"expected":N,"executed":N,"exact":N,"strict":N,"near":N,"defer":N,"skip":N,"fail":N,"missing":N}
#
# The entrypoint counts the full authority manifest (currently 210 ids) and
# the port bundle now implements all of them (the reactive/mesh
# external-input cases included), so the whole-port run exits 0 with nothing
# missing. This suite accepts exactly the recorded authority state and
# nothing else: the denominator must equal the recorded authority-manifest
# size (210); near/defer/skip/fail/missing must be zero; every executed case
# must pass (exact + strict == executed and executed + missing == expected).
# On the all-pass path there must be no not-in-bundle warning, so a changed
# denominator with all cases passing also fails. Any difference, runtime or
# oracle error, or unknown id still fails. When the authority manifest or the
# bundle changes, update RECORDED_EXPECTED below.
RECORDED_EXPECTED=210
wait "$PARITY_PID" || true
RC=$(cat "$PARITY_LOG.rc" 2>/dev/null || echo 1)
OUT=$(cat "$PARITY_LOG" 2>/dev/null || true)
rm -f "$PARITY_LOG" "$PARITY_LOG.rc"
printf '%s\n' "$OUT"
LINE=$(printf '%s\n' "$OUT" | tail -1)
WARN=$(printf '%s\n' "$OUT" | sed -n 's/^not in the port bundle (no executable case); counted missing: //p')
case "$LINE" in
  PARITY-SUMMARY\ *{\"expected\":*) ;;
  *) echo "scripts/test: parity-summary exited $RC without a final PARITY-SUMMARY line" >&2; exit "$RC" ;;
esac
field() { printf '%s' "$LINE" | sed -E "s/.*\"$1\":([0-9]+).*/\\1/"; }
EXPECTED=$(field expected); EXECUTED=$(field executed); EXACT=$(field exact)
STRICT=$(field strict); NEAR=$(field near); DEFER=$(field defer)
SKIP=$(field skip); FAIL=$(field fail); MISSING=$(field missing)
WARN_N=$(printf '%s\n' $WARN | wc -l)
REJECT_RC=$RC
[ "$REJECT_RC" -ne 0 ] || REJECT_RC=1
if [ "$EXPECTED" -ne "$RECORDED_EXPECTED" ] ||
   [ "$NEAR" -ne 0 ] || [ "$DEFER" -ne 0 ] || [ "$SKIP" -ne 0 ] || [ "$FAIL" -ne 0 ] ||
   [ $((EXACT + STRICT)) -ne "$EXECUTED" ] || [ $((EXECUTED + MISSING)) -ne "$EXPECTED" ]; then
  echo "scripts/test: parity-summary exited $RC on an unaccepted parity state: $LINE (recorded denominator: $RECORDED_EXPECTED)" >&2
  exit "$REJECT_RC"
fi
if [ "$RC" -eq 0 ]; then
  # All-pass path: the recorded denominator must hold with nothing missing
  # and no not-in-bundle warning; a changed denominator with all cases
  # passing is rejected above by the EXPECTED check.
  [ -z "$WARN" ] || { echo "scripts/test: parity-summary exited 0 with an unexpected not-in-bundle warning: $WARN" >&2; exit 1; }
  # Release gate: audit the complete summary output with scripts/release-gate.rb
  # (this port declares no skips and accepts no failures). The gate reads the
  # authority manifest from the pinned oracle: prefer the oracle parity-summary
  # provisioned (its warning names the directory), else pass through
  # NOISEMAKER_CPU_DIR; with a sibling pinned checkout the gate resolves it
  # itself.
  ORACLE_DIR=$(printf '%s\n' "$OUT" | sed -n 's/^scripts\/parity-summary: using provisioned oracle at //p' | tail -1)
  if [ -n "$ORACLE_DIR" ]; then
    export NOISEMAKER_CPU_DIR="$ORACLE_DIR"
  elif [ -n "${NOISEMAKER_CPU_DIR:-}" ]; then
    export NOISEMAKER_CPU_DIR
  fi
  GATE_LOG=$(mktemp "${TMPDIR:-/tmp}/parity-summary-release-gate.XXXXXX")
  trap 'rm -f "$GATE_LOG" "$PARITY_LOG" "$PARITY_LOG.rc"' EXIT
  printf '%s\n' "$OUT" > "$GATE_LOG"
  if ! "$RUBY_BIN" scripts/release-gate.rb "$GATE_LOG" \
       --declared-skips '' --accepted-failures '' >&2; then
    echo "scripts/test: release gate rejected the whole-port summary" >&2
    exit 1
  fi
  echo "scripts/test: parity gate accepted the all-pass authority state: $LINE" >&2
  exit 0
fi
# No missing ids are recorded any more: any nonzero exit already failed the
# unaccepted-state check above (fail/defer/missing cannot be zero on an
# exit-1 run), so this line is unreachable except as a hard stop.
echo "scripts/test: parity-summary exited $RC on an unaccepted parity state: $LINE" >&2
exit "$REJECT_RC"
