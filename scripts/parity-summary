#!/bin/sh
# PARITY-SUMMARY contract entrypoint.
#
# Renders the current authority's manifest cases with this port and compares
# each against the authority golden (pinned noisemaker-cpu oracle, located
# via NOISEMAKER_CPU_DIR like scripts/parity.rb). Given case ids as
# arguments, renders and counts only those; with no arguments, covers the
# whole port. The last output line is
#   PARITY-SUMMARY {"expected":N,"executed":N,"exact":N,"strict":N,"near":N,"defer":N,"skip":N,"fail":N,"missing":N}
# and the exit status is 0 iff executed == expected, exact + strict ==
# expected, and near, defer, skip, fail and missing are all zero.
#
# This wrapper bootstraps a usable Ruby >= 3.2 (scripts/ruby-bootstrap.sh),
# then runs scripts/parity-summary.rb, which documents the count fields.
set -eu
cd "$(dirname "$0")/.."
. ./scripts/ruby-bootstrap.sh
exec "$RUBY_BIN" scripts/parity-summary.rb "$@"
